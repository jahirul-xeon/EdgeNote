rules_version = '2';

// Attachments (Sprint 4) live under /users/{uid}/... and are private to the
// authenticated owner (§30).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
